# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Check out text files with LF endings on every platform, so tests that compare
# file contents behave the same on Windows.
* text=auto eol=lf

*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.avif binary
*.heic binary
*.tiff binary
*.pdf binary
*.mp4 binary
*.webm binary

# Leave everything but the package itself out of the dist archive.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/art                export-ignore
/docs               export-ignore
/tests              export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon.dist  export-ignore
/phpstan-baseline.neon export-ignore
/CHANGELOG.md       export-ignore
/UPGRADING.md       export-ignore
